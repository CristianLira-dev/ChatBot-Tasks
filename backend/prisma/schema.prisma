generator cliente {
  provider = "prisma-client-js"
}

datasource banco {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoTarefa {
  tarefa
  prova
  trabalho
  aula
  compromisso
  outro
}

enum PrioridadeTarefa {
  baixa
  media
  alta
}

enum StatusTarefa {
  pendente
  concluida
  cancelada
}

enum StatusLembrete {
  agendado
  enviado
  falhou
  cancelado
}

enum DirecaoMensagem {
  entrada
  saida
}

model Usuario {
  id                     String                  @id @default(cuid())
  nome                   String
  telefone               String?                 @unique
  email                  String                  @unique
  senhaCriptografada     String
  fusoHorario            String                  @default("America/Sao_Paulo")
  criadoEm               DateTime                @default(now())
  atualizadoEm           DateTime                @updatedAt
  tarefas                Tarefa[]
  conexoesCalendario     ConexaoCalendario[]
  lembretes              Lembrete[]
  conversas              Conversa[]
  eventosWebhook         EventoWebhook[]
  registrosSincronizacao RegistroSincronizacao[]
  eventosCalendario      EventoCalendario[]
}

model Tarefa {
  id                String             @id @default(cuid())
  usuarioId         String
  titulo            String
  descricao         String?
  materia           String?
  tipo              TipoTarefa         @default(tarefa)
  dataEntrega       DateTime
  horarioEntrega    String?
  duracao           Int?
  prioridade        PrioridadeTarefa   @default(media)
  status            StatusTarefa       @default(pendente)
  criadoEm          DateTime           @default(now())
  atualizadoEm      DateTime           @updatedAt
  usuario           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lembretes         Lembrete[]
  eventosCalendario EventoCalendario[]

  @@index([usuarioId, status])
  @@index([usuarioId, dataEntrega])
}

model ConexaoCalendario {
  id                            String    @id @default(cuid())
  usuarioId                     String
  provedor                      String
  emailConta                    String?
  tokenAcessoCriptografado      String?
  tokenAtualizacaoCriptografado String?
  expiraEm                      DateTime?
  status                        String    @default("disponivel")
  ultimoSincronismoEm           DateTime?
  criadoEm                      DateTime  @default(now())
  atualizadoEm                  DateTime  @updatedAt
  usuario                       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, provedor])
  @@index([usuarioId, status])
}

model EventoCalendario {
  id                         String    @id @default(cuid())
  usuarioId                  String
  tarefaId                   String
  provedor                   String
  identificadorEventoExterno String?
  identificadorCalendario    String?
  dataInicio                 DateTime
  dataFim                    DateTime
  fusoHorario                String
  statusSincronizacao        String    @default("pendente")
  ultimaVersaoExternaEm      DateTime?
  ultimoSincronismoEm        DateTime?
  criadoEm                   DateTime  @default(now())
  atualizadoEm               DateTime  @updatedAt
  usuario                    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tarefa                     Tarefa    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@unique([provedor, identificadorEventoExterno])
  @@index([usuarioId, provedor])
  @@index([tarefaId])
}

model Lembrete {
  id           String         @id @default(cuid())
  tarefaId     String
  usuarioId    String
  agendadoPara DateTime
  tipo         String
  status       StatusLembrete @default(agendado)
  tentativas   Int            @default(0)
  enviadoEm    DateTime?
  criadoEm     DateTime       @default(now())
  tarefa       Tarefa         @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, status, agendadoPara])
  @@index([tarefaId])
}

model Conversa {
  id               String     @id @default(cuid())
  usuarioId        String
  telefone         String
  intencaoPendente String?
  dadosPendentes   Json?
  criadoEm         DateTime   @default(now())
  atualizadoEm     DateTime   @updatedAt
  usuario          Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagens        Mensagem[]

  @@unique([usuarioId, telefone])
  @@index([telefone])
}

model Mensagem {
  id                           String          @id @default(cuid())
  conversaId                   String
  identificadorMensagemExterna String?
  direcao                      DirecaoMensagem
  conteudo                     String
  tipoMensagem                 String          @default("texto")
  statusProcessamento          String          @default("pendente")
  criadoEm                     DateTime        @default(now())
  atualizadoEm                 DateTime        @updatedAt
  conversa                     Conversa        @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@unique([conversaId, identificadorMensagemExterna])
  @@index([conversaId, criadoEm])
}

model EventoWebhook {
  id                         String    @id @default(cuid())
  usuarioId                  String?
  provedor                   String
  identificadorEventoExterno String
  tipoEvento                 String
  dados                      Json
  statusProcessamento        String    @default("recebido")
  recebidoEm                 DateTime  @default(now())
  processadoEm               DateTime?
  usuario                    Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([provedor, identificadorEventoExterno])
  @@index([statusProcessamento, recebidoEm])
}

model RegistroSincronizacao {
  id           String    @id @default(cuid())
  usuarioId    String
  provedor     String
  operacao     String
  status       String
  mensagemErro String?
  iniciadoEm   DateTime  @default(now())
  finalizadoEm DateTime?
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, provedor, iniciadoEm])
}
